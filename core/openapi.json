{
  "openapi": "3.0.3",
  "info": {
    "title": "Moneypenny Chat core",
    "version": "0.3.1",
    "description": "Error body is always {\"error\": code, \"message\": text}. Every response has x-mpc-core-version."
  },
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "summary": "Version",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/v1/help/topics": {
      "get": {
        "summary": "Help topics (served from the instance; the core defines the shape)",
        "x-status": "planned",
        "responses": {
          "501": {
            "description": "Not built in 0.1.0"
          }
        }
      }
    },
    "/v1/tickets": {
      "post": {
        "summary": "Create a ticket",
        "x-status": "built",
        "security": [
          {
            "signature": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "$ref": "#/components/parameters/ts"
          },
          {
            "$ref": "#/components/parameters/nonce"
          },
          {
            "$ref": "#/components/parameters/sig"
          },
          {
            "$ref": "#/components/parameters/assertion"
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created, or the same answer again with header idempotent-replay: true",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/screenshots": {
      "post": {
        "summary": "Upload a screenshot (png, jpeg or webp, up to 2 MB). Held 1 hour unless a ticket uses it.",
        "x-status": "built",
        "security": [
          {
            "signature": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "$ref": "#/components/parameters/ts"
          },
          {
            "$ref": "#/components/parameters/nonce"
          },
          {
            "$ref": "#/components/parameters/sig"
          },
          {
            "$ref": "#/components/parameters/assertion"
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "screenshot_id": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "expires": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad_request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "bad_signature or no_assertion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate; header retry-after",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "try_later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "bad_type: type or first bytes not accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/{ticket}": {
      "get": {
        "summary": "Read a ticket status",
        "x-status": "built",
        "security": [
          {
            "signature": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "$ref": "#/components/parameters/ts"
          },
          {
            "$ref": "#/components/parameters/nonce"
          },
          {
            "$ref": "#/components/parameters/sig"
          },
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^T-\\d{4,}$"
            }
          },
          {
            "name": "x-mpc-status-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketStatus"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ai-links": {
      "post": {
        "summary": "Create an AI link. Scopes come from a fixed list. A named ticket needs its x-mpc-status-token (added).",
        "x-status": "built",
        "security": [
          {
            "signature": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "$ref": "#/components/parameters/ts"
          },
          {
            "$ref": "#/components/parameters/nonce"
          },
          {
            "$ref": "#/components/parameters/sig"
          },
          {
            "$ref": "#/components/parameters/assertion"
          },
          {
            "name": "x-mpc-status-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scopes",
                  "key_hash",
                  "product_key_id"
                ],
                "properties": {
                  "ticket": {
                    "type": "string",
                    "nullable": true
                  },
                  "screen": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "read_ticket",
                        "read_event",
                        "edit_event",
                        "create_event",
                        "invite",
                        "report"
                      ]
                    }
                  },
                  "key_hash": {
                    "type": "string"
                  },
                  "ttl_s": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 86400
                  },
                  "product_key_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; the instance adds k to link",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "link": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "expires": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad_request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "bad_signature or no_assertion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate; header retry-after",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "try_later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ai-links/{id}": {
      "delete": {
        "summary": "Stop an AI link (same organizer session only)",
