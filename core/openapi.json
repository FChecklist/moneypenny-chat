            "description": "Not built in 0.1.0"
          }
        }
      }
    },
    "/v1/tickets": {
      "post": {
        "summary": "Create a ticket",
        "x-status": "built",
        "security": [
          {
            "signature": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "$ref": "#/components/parameters/ts"
          },
          {
            "$ref": "#/components/parameters/nonce"
          },
          {
            "$ref": "#/components/parameters/sig"
          },
          {
            "$ref": "#/components/parameters/assertion"
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created, or the same answer again with header idempotent-replay: true",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/screenshots": {
      "post": {
        "summary": "Upload a screenshot",
        "x-status": "planned",
        "responses": {
          "501": {
            "description": "Not built in 0.1.0"
          }
        }
      }
    },
    "/v1/tickets/{ticket}": {
      "get": {
        "summary": "Read a ticket status",
        "x-status": "built",
        "security": [
          {
            "signature": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "$ref": "#/components/parameters/ts"
          },
          {
            "$ref": "#/components/parameters/nonce"
          },
          {
            "$ref": "#/components/parameters/sig"
          },
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^T-\\d{4,}$"
            }
          },
          {
            "name": "x-mpc-status-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketStatus"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ai-links": {
      "post": {
        "summary": "Create an AI link",
        "x-status": "planned",
        "responses": {
