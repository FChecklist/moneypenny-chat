{
  "openapi": "3.0.3",
  "info": {
    "title": "Moneypenny Chat core",
    "version": "0.1.2",
    "description": "Error body is always {\"error\": code, \"message\": text}. Every response has x-mpc-core-version."
  },
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "summary": "Version",
        "responses": {
