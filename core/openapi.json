  "components": {
    "securitySchemes": {
      "signature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-mpc-sig",
        "description": "HMAC-SHA256(secret, method + \"\\n\" + path + \"\\n\" + ts + \"\\n\" + nonce + \"\\n\" + sha256(body) [+ \"\\n\" + x-mpc-ip when that header is sent]); time gap at most 300 s; nonce used once"
      }
    },
    "parameters": {
      "instance": {
        "name": "x-mpc-instance",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ts": {
        "name": "x-mpc-ts",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\d{9,12}$"
        }
      },
      "nonce": {
        "name": "x-mpc-nonce",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "sig": {
        "name": "x-mpc-sig",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "assertion": {
        "name": "x-mpc-assertion",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "enum": [
              "bad_request",
              "bad_signature",
              "no_assertion",
              "no_team_login",
              "origin",
              "role",
              "not_found",
              "idempotency_conflict",
              "too_large",
              "bad_type",
              "rate",
              "try_later"
            ]
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "retry_after": {
            "type": "integer"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "ok",
          "core",
          "time"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "core": {
            "type": "string"
          },
          "time": {
            "type": "integer"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "core",
          "api",
          "min_instance"
        ],
        "properties": {
          "core": {
            "type": "string"
          },
          "api": {
            "type": "string"
          },
          "min_instance": {
            "type": "string"
          }
        }
      },
      "TicketIn": {
        "type": "object",
        "required": [
          "option"
        ],
        "properties": {
          "option": {
            "enum": [
              "help_more",
              "suggest",
              "stuck"
            ]
          },
          "type": {
            "enum": [
              "option",
              "feature",
              "wording",
              null
            ],
            "nullable": true
          },
          "topic": {
            "type": "string",
            "nullable": true
          },
          "screen": {
            "type": "string"
          },
          "screen_label": {
            "type": "string",
            "maxLength": 60
          },
          "text": {
            "type": "string",
            "maxLength": 600
          },
          "screenshot_id": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "enum": [
              "organizer",
              "co-organizer"
            ]
          },
          "client": {
            "type": "object",
            "properties": {
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              },
              "ua_class": {
                "enum": [
                  "mobile",
                  "desktop"
                ]
              }
            }
          }
        }
      },
      "TicketOut": {
        "type": "object",
        "required": [
          "ticket",
          "status_token",
          "erase_at"
        ],
        "properties": {
          "ticket": {
            "type": "string"
          },
          "status_token": {
            "type": "string"
          },
          "erase_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TicketStatus": {
        "type": "object",
        "required": [
          "ticket",
          "status",
          "team_note",
          "updated"
        ],
        "properties": {
          "ticket": {
            "type": "string"
          },
          "status": {
            "enum": [
              "new",
              "seen",
              "done"
            ]
          },
          "team_note": {
            "type": "string"
          },
          "updated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TeamList": {
        "type": "object",
        "required": [
          "items",
          "cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AiError": {
        "type": "object",
        "required": [
          "error",
          "message",
          "next"
        ],
        "properties": {
          "error": {
            "enum": [
              "bad_link",
              "expired",
              "revoked",
              "forbidden_action",
              "out_of_scope",
              "ticket_gone",
              "plan_not_approved",
              "too_large",
              "bad_note",
              "slow_down",
              "try_later"
            ]
          },
          "message": {
            "type": "string"
          },
          "next": {
            "type": "string"
          },
          "retry_after": {
            "type": "integer"
          }
        }
      }
    }
  }
}
