    "/v1/ai/notes": {
      "post": {
        "summary": "AI note: plan, step, done or blocked, up to 800 characters",
        "x-status": "built",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "plan",
                      "step",
                      "done",
                      "blocked"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 800
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored; says what comes next"
          },
          "401": {
