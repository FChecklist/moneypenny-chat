{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moneypenny Chat instance record",
  "type": "object",
  "required": ["id", "name", "allowed_origins", "retention_class", "enabled"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,39}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "allowed_origins": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://[^/?#]+$" } },
    "retention_class": { "enum": ["games", "records"] },
    "enabled": { "type": "boolean" },
    "routes": { "type": "object", "propertyNames": { "pattern": "^/[^?#\\s\\d@]*$" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 40 } },
    "ai_calls": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "role_map": { "type": "object", "additionalProperties": { "enum": ["organizer", "co-organizer"] } },
    "core_min": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "core_max": { "type": "string", "pattern": "^\\d+\\.(\\d+|x)$" },
    "kb_version": { "type": "string", "maxLength": 40 },
    "tickets_per_day": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "require_ip": { "type": "boolean" },
    "brand": { "type": "object", "required": ["primary"], "properties": { "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } }
  }
}
